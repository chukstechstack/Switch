<Page x:Class="Switch.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0A0A0B">

    <ScrollViewer>
        <StackPanel Margin="36" HorizontalAlignment="Center" Width="1100">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,10">
                <StackPanel>
                    <TextBlock Text="SWITCH" FontSize="44" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Reclaim your focus" FontSize="18" Foreground="#8A8A8E" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" Foreground="#B4FF39" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="CreateNewBtn" Content="+" Width="72" Height="72" HorizontalAlignment="Right" Margin="0" Background="#B4FF39" Foreground="#04111A" FontWeight="Bold" FontSize="28" BorderThickness="0" Click="GoToCreate_Click"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StatusLabel" Foreground="#B4FF39" FontWeight="Bold" Margin="0,8,0,0" />

            <TextBlock Text="Blocked Apps" FontSize="26" Foreground="#8A8A8E" Margin="0,24,0,12" />

            <ItemsControl x:Name="BlocksList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#161617" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="28" Padding="24" Margin="12" Width="520" Height="200">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon circle / fallback initials -->
                                <Border Width="72" Height="72" CornerRadius="36" Background="#272727" VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding AppName, Converter={StaticResource FirstLetterConverter}}" Foreground="#B4FF39" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding AppName}" Foreground="White" FontWeight="Bold" FontSize="28" />
                                        <TextBlock Text="  "/>
                                        <TextBlock Text="{Binding BlockName}" Foreground="#8A8A8E" FontSize="18" Margin="12,8,0,0" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                        <!-- Normal countdown -->
                                        <Border Background="#0F0F10" CornerRadius="16" Padding="8,4" VerticalAlignment="Center" Visibility="{Binding IsPendingDelete, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=False}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource PulsingDotStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding CountdownText}" Foreground="#B4FF39" FontFamily="Cascadia Code, Consolas, 'Courier New'" FontSize="13" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Emergency pending delete countdown -->
                                        <Border Background="#2A1F12" CornerRadius="16" Padding="8,4" VerticalAlignment="Center" Visibility="{Binding IsPendingDelete, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="#FFB34D" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding CountdownText}" Foreground="#FFB34D" FontFamily="Cascadia Code, Consolas, 'Courier New'" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,12,0,0" Foreground="#B4FF39" Background="#0F0F10"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource DeleteButtonStyle}" Content="Delete" Click="OnDeleteClicked" Tag="{Binding Id}" />
                                        <Button Content="Edit" Click="OnEditClicked" Tag="{Binding Id}" Padding="6" Width="100" Margin="8,0,0,0" IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBooleanConverter}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="ToolTip" Value="Edit block" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                            <Setter Property="ToolTip" Value="Editing is disabled while this block is active" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button x:Name="CancelPendingBtn" Content="7-day wait" Click="OnCancelPendingClicked" Tag="{Binding Id}" Padding="6" Width="140" Margin="8,0,0,0" Visibility="{Binding IsPendingDelete, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="False" ToolTip="Emergency unlock is disabled. You must wait the full 7-day period." />

                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
