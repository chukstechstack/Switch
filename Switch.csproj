<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Suppress auto-generated AssemblyInfo to avoid duplicate attribute errors with WPF temp projects -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Assets\Images\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\Switch_Icon.ico" />
  </ItemGroup>

  <!-- ApplicationIcon/Win32Icon: enable embedding of the ICO into the built EXE. Ensure Assets\Switch_Icon.ico exists and is a valid multi-size .ico -->
  <PropertyGroup>
    <ApplicationIcon>Assets\Switch_Icon.ico</ApplicationIcon>
    <Win32Icon>Assets\Switch_Icon.ico</Win32Icon>
  </PropertyGroup>

  <!-- No ApplicationIcon specified; Window uses vector DrawingImage resource for runtime icon -->

  <!-- If you want to generate a proper .ico at build time, add a build step here. Currently we use a vector DrawingImage for Window.Icon. -->

  <!-- Exclude tools and helper projects from the main app compile (they live in subfolders) -->
  <ItemGroup>
    <Compile Remove="UninstallChecker\**\*.cs" />
    <Compile Remove="Service\obj\**\*.cs" />
    <Compile Remove="Service\bin\**\*.cs" />
    <!-- Exclude only the host/service entry point files that belong to the separate service host project -->
    <Compile Remove="Service\HostProgram.cs" />
    <Compile Remove="Service\BlockEnforcerService.cs" />
  </ItemGroup>

