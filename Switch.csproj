  <!-- If the app is still running from a previous debug session, kill it before build to avoid file lock errors -->
  <Target Name="KillRunningAppBeforeBuild" BeforeTargets="BeforeBuild">
    <Exec Command="taskkill /F /IM Switch.exe" ContinueOnError="true" />
  </Target>

