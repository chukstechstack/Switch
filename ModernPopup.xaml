<Window x:Class="Switch.ModernPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight" ShowInTaskbar="False" Topmost="True">
    <Border CornerRadius="28" Background="#161617" BorderBrush="#2A2A2A" BorderThickness="1" Padding="28" Effect="{DynamicResource PopupShadow}">
        <StackPanel Width="640" HorizontalAlignment="Center">
            <TextBlock Text="🔒" FontSize="72" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Text="STAY FOCUSED!" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,14,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="MessageText" Text="You have 6d 23h left! No cheating bro!" Foreground="#8A8A8E" TextWrapping="Wrap" Margin="0,18,0,18" HorizontalAlignment="Center" FontSize="18"/>
            <Border CornerRadius="14" Background="#B4FF39" HorizontalAlignment="Center" Width="360">
                <Button x:Name="OkButton" Content="I WILL WAIT - 7 DAYS!" Background="Transparent" Foreground="Black" Padding="14" FontWeight="Bold" HorizontalAlignment="Center" BorderThickness="0" FontSize="16" />
            </Border>
        </StackPanel>
    </Border>
</Window>