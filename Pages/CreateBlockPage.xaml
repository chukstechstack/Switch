<Page x:Class="Switch.Pages.CreateBlockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0A0A0B">
    <ScrollViewer x:Name="MainScroll">
    <StackPanel Width="1000" HorizontalAlignment="Center" Margin="32">
        <TextBlock Text="Create New Block" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,10" />
        <TextBlock Text="App name (e.g. chrome)" Foreground="#8A8A8E" Margin="0,8,0,0" FontSize="18" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,12" Height="48">
            <TextBox x:Name="AppBox" Padding="14" FontSize="18" Width="820" />
            <Button x:Name="ShowRelatedBtn" Content="⋯" Width="48" Margin="8,0,0,0" FontSize="18" ToolTip="Show related installed and running apps" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Left">
            <Button x:Name="SelectFolderBtn" Content="SELECT FOLDER" Padding="10" Margin="0,0,12,0" Background="#272727" Foreground="White" Height="40" />
            <TextBlock Text="or paste path:" VerticalAlignment="Center" Foreground="#8A8A8E" Margin="0,6,6,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Left">
            <CheckBox x:Name="InstallerBlockCheck" Content="Enable installer blocking (opt-in)" Foreground="#B4FF39" Margin="0,4,0,0" />
        </StackPanel>

        <Button x:Name="SelectRunningBtn" Content="SELECT INSTALLED APPS" Padding="12" Margin="0,0,0,12" Background="#272727" Foreground="White" Height="52" FontSize="16" />
        <Button x:Name="SelectProcessesBtn" Content="PICK RUNNING PROCESS" Padding="12" Margin="0,0,0,12" Background="#272727" Foreground="White" Height="52" FontSize="16" />

        <TextBlock Text="Select end date and time" Foreground="#8A8A8E" Margin="0,14,0,0" FontSize="16" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
            <!-- Calendar icon using Segoe MDL2 Assets for a modern calendar glyph -->
            <Border Width="48" Height="48" Background="#272727" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,12,0">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="\uE787" Foreground="#B4FF39" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <DatePicker x:Name="EndDatePicker" Width="300" Height="44" FontSize="16" />
            <ComboBox x:Name="HourCombo" Width="120" Margin="12,0,0,0" FontSize="16" />
            <ComboBox x:Name="MinuteCombo" Width="120" Margin="12,0,0,0" FontSize="16" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button x:Name="CancelBtn" Content="Cancel" Padding="12" Margin="0,0,12,0" Height="52" Width="160" />
            <Button x:Name="CreateBtn" Content="CREATE BLOCK" Padding="12" Background="#B4FF39" Foreground="Black" Height="52" Width="220" FontSize="18" />
        </StackPanel>

        <!-- Installed apps list: constrained height so it scrolls instead of expanding the page -->
        <TextBox x:Name="RunningSearch" Visibility="Collapsed" Width="420" Height="36" Margin="0,8,0,0" Padding="8" FontSize="14" />
        <ListBox x:Name="RunningList" Visibility="Collapsed" Margin="0,6,0,0" Background="#161617" Foreground="White" MaxHeight="380"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="16" />

        <TextBox x:Name="ProcessSearch" Visibility="Collapsed" Width="420" Height="36" Margin="0,8,0,0" Padding="8" FontSize="14" />
        <ListBox x:Name="ProcessesList" Visibility="Collapsed" Margin="0,6,0,0" Background="#161617" Foreground="White" MaxHeight="380"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="16" />

        <!-- Popup for related apps (installed + running) -->
        <Popup x:Name="RelatedPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
            <Border Background="#161617" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="8">
                <StackPanel Width="520">
                    <TextBox x:Name="RelatedSearch" Padding="8" Height="36" FontSize="14" />
                    <TextBlock Text="Installed apps" Foreground="#8A8A8E" Margin="4,8,0,2" />
                    <ListBox x:Name="RelatedInstalledList" Background="#161617" Foreground="White" MaxHeight="140" />
                    <TextBlock Text="Running processes" Foreground="#8A8A8E" Margin="4,8,0,2" />
                    <ListBox x:Name="RelatedRunningList" Background="#161617" Foreground="White" MaxHeight="140" />
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
    </ScrollViewer>
</Page>
